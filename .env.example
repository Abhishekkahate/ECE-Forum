# ═══════════════════════════════════════════════════════════════════════════
# ECE FORUM ENVIRONMENT CONFIGURATION (Vercel, Render & Supabase)
# ═══════════════════════════════════════════════════════════════════════════

# Render Backend REST API URL (Used by Vercel Frontend & Mobile clients)
# Local: http://localhost:5000/api
# Production: https://your-ece-forum-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Supabase Project URL & Anon Key (Get from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Used only on Render Backend server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Razorpay Key
VITE_RAZORPAY_KEY_ID=rzp_test_51a2b3c4d5e6f7
